# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored. Never commit real secrets.
#
# These same variables must also be set in the Vercel dashboard
# (Project → Settings → Environment Variables) for the deployed site.

# --- AI assistant (Gemini) -------------------------------------------------
# Server-only. This is read exclusively inside the /api/chat route handler and
# is never exposed to the browser. Do NOT prefix it with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash

# --- Contact form (Gmail SMTP) ---------------------------------------------
# EMAIL_PASS must be a Google App Password, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# --- Site ------------------------------------------------------------------
# Absolute base URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://project-x-alexdev93.vercel.app
