# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored. Never commit real secrets.
#
# These same variables must also be set in the Vercel dashboard
# (Project → Settings → Environment Variables) for the deployed site.
#
# Only GEMINI_API_KEY is required. Everything else has a working default.

# --- AI assistant ----------------------------------------------------------
# Server-only. Read exclusively inside the AI modules and never exposed to the
# browser. Do NOT prefix it with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model. Default: gemini-3.5-flash-lite — current generation, free tier,
# supports tool calling and streaming. Raise to gemini-3.7-flash for stronger
# reasoning (also free tier, higher paid rate).
AI_MODEL=gemini-3.5-flash-lite

# Embedding model and output width. 768 keeps the table small; the model also
# supports 1536 and 3072. Changing this requires editing the VECTOR(...) width
# in src/lib/db/schema.sql and re-running `yarn db:migrate` + `yarn ingest`.
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768

# --- Retrieval -------------------------------------------------------------
# Chunks fetched per question, and the minimum cosine similarity to count as
# relevant. Below the threshold a chunk is dropped rather than cited.
#
# 0.66 is measured against this corpus: correct answers score 0.664-0.734 while
# the best off-topic match tops out at 0.633, so the threshold sits in the gap.
# Lowering it makes answers cite content they did not really use.
RAG_TOP_K=5
RAG_MIN_SCORE=0.66

# --- Vector store (optional) ----------------------------------------------
# Postgres with pgvector. Neon's free tier is enough for this corpus.
#
# OPTIONAL BY DESIGN: with this unset the assistant still works — it answers
# from the full portfolio context and simply omits source citations. A cold,
# missing or over-quota database degrades citations, never the chat.
DATABASE_URL=

# --- Limits and caching ----------------------------------------------------
# Requests per window per IP, and the window in seconds.
AI_RATE_LIMIT=10
AI_RATE_WINDOW=60

# Cached answer lifetime in seconds. 0 disables caching.
AI_CACHE_TTL=3600

# Input caps and the upstream timeout in milliseconds.
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_HISTORY=20
AI_TIMEOUT_MS=30000

# --- Sign-in (Google, via Better Auth) -------------------------------------
# All three are needed together, or none. Missing any of them disables sign-in
# and nothing else: the blog still reads perfectly, because reading never
# requires a session. Comment forms are replaced with a note, and /api/auth/*
# returns 503 while logging exactly which variable is absent.
#
# Server-only, every one of them. There is no NEXT_PUBLIC_ variable in this
# feature at all — the OAuth redirect is built on the server.
#
# BETTER_AUTH_SECRET signs the session cookie. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
#
# From the Google Cloud console: APIs & Services → Credentials → OAuth client ID
# (Web application). Free. Add BOTH redirect URIs:
#   https://<your-site>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Administrators --------------------------------------------------------
# Comma-separated email addresses allowed into /admin. Compared exactly, after
# trimming and lower-casing, and the address must be verified by its provider.
#
# FAILS CLOSED: unset or empty means nobody is an administrator, including the
# owner. That is deliberate — a deployment that forgets this variable locks the
# admin panel rather than opening it.
#
# Deliberately not a database column. Administrator rights are configuration,
# so no SQL write path can grant them; the database only ever stores the
# opposite capability, in blocked_users.
ADMIN_EMAILS=

# --- Blog (all optional) ---------------------------------------------------
# Every one of these has a working default; they exist for tuning, not setup.
BLOG_PAGE_SIZE=10
BLOG_REVALIDATE_SECONDS=300
BLOG_COMMENT_MAX_LENGTH=2000
BLOG_COMMENT_RATE_LIMIT=5
BLOG_COMMENT_RATE_WINDOW=300
BLOG_COMMENT_EDIT_WINDOW_MINUTES=15
#
# `post` publishes comments immediately and lets you hide them afterwards;
# `pre` holds every comment for approval. A comment carrying three or more links
# is held for approval either way — held, not rejected, so a legitimate
# link-heavy reply costs its author a delay rather than their words.
BLOG_COMMENT_MODERATION=post

# --- Site content editor (optional) ----------------------------------------
# Lets /admin/content save changes to the portfolio's text. Saving writes a
# commit to the repository, which triggers a deployment — so the token needs to
# write files, and nothing else.
#
# Create a FINE-GRAINED personal access token at
# https://github.com/settings/personal-access-tokens/new
#   Repository access: only this repository
#   Permissions:       Contents → Read and write
# Nothing more. A classic token with `repo` scope would reach every repository
# you can see, which this feature has no need for.
#
# Unset, the editor still shows the current content but cannot save.
GITHUB_TOKEN=
GITHUB_REPO=alexdev93/project-x
# The branch commits land on. Defaults to main.
GITHUB_BRANCH=main

# --- Contact form (Gmail SMTP) ---------------------------------------------
# EMAIL_PASS must be a Google App Password, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# --- Site ------------------------------------------------------------------
# Absolute base URL, used for canonical URLs, sitemap and Open Graph tags.
# Falls back to the Vercel deployment URL when unset.
NEXT_PUBLIC_SITE_URL=https://project-x-alexdev93.vercel.app
